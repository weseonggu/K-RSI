# 애플리케이션 실행에 필요한 환경변수 목록.
# 이 파일을 복사해 .env 를 만들고 실제 값을 채운 뒤,
# IDE 실행 구성(Run Configuration) 또는 셸 환경변수로 주입한다.
# (.env 는 gitignore 대상이며 절대 커밋하지 않는다)

# MySQL (docker/docker-compose.yml 의 계정과 동일해야 함)
RSI_DB_USERNAME=dnltjdrn
RSI_DB_PASSWORD=

# 데이터 DB HikariCP 커넥션 풀 (선택 — 미설정 시 application-*.yml 기본값 사용)
# RSI_DATA_DB_POOL_MAX=20
# RSI_DATA_DB_POOL_MIN_IDLE=5
# RSI_DATA_DB_CONNECTION_TIMEOUT=30000
# RSI_DATA_DB_LEAK_DETECTION=60000

# Redis
RSI_REDIS_PASSWORD=

# KRX Open API 인증 키 (https://openapi.krx.co.kr 에서 발급)
KRX_API_KEY=
