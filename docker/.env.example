# docker compose / 배포 스크립트용 환경변수. 이 파일을 복사해 docker/.env 를 만들고 값을 채운다.
# (docker compose 는 compose 파일과 같은 디렉터리의 .env 를 자동으로 읽는다)

# Docker Hub (이미지: <DOCKERHUB_ID>/rsi-collector, rsi-api, rsi-frontend)
DOCKERHUB_ID=weseeonggu
TAG=latest

# MySQL root
MYSQL_META_ROOT_PASSWORD=
MYSQL_DATA_ROOT_PASSWORD=

# 애플리케이션(.env.example)과 동일한 값 사용
RSI_DB_USERNAME=dnltjdrn
RSI_DB_PASSWORD=
RSI_REDIS_PASSWORD=

# KRX Open API 인증 키 (collector 컨테이너에서 사용)
KRX_API_KEY=

# OPEN DART API 인증 키 (collector에서 사업보고서를 수집할 때 사용)
DART_API_KEY=

# 기동 시 캐치업 (첫 배포면 200일 백필, 이후에는 마지막 수집일부터 갭 수집)
RSI_BOOTSTRAP_ENABLED=true

# 일일 수집 cron (Asia/Seoul 기준, Spring cron 6필드).
# "전일" 데이터를 수집하므로 요일 범위 주의:
#   KRX는 전 거래일 데이터를 익일(토요일 포함) 아침 08:00 정각에 공개 (2026-07-10~11 프로브 실측).
#   0 5 8 * * TUE-SAT   → 08:05 1차 수집 (공개 5분 후).
#   0 30 21 * * TUE-SAT → 21:30 보정. KRX 공개가 늦는 날 같은 날짜를 재수집(멱등이라 중복 무해).
#   요일이 하루 밀리므로 화→월, 수→화, 목→수, 금→목, 토→금으로 거래일 5일과 1:1 대응한다.
#   MON-FRI로 두면 월요일 실행분은 yesterday=일요일이라 스킵되고 금요일 데이터가 영영 수집되지 않는다.
#   이 값이 코드/컴포즈 기본값이기도 하다(운영 서버 192.168.0.23도 동일).
SCHEDULER_MASTER_CRON=0 5 8 * * TUE-SAT
SCHEDULER_MASTER_RETRY_CRON=0 30 21 * * TUE-SAT

# 호스트 포트 매핑 (해당 포트가 이미 사용 중인 서버에서 변경)
FRONTEND_PORT=80
API_PORT=8081
COLLECTOR_PORT=8080
