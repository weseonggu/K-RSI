# docker compose / 배포 스크립트용 환경변수. 이 파일을 복사해 docker/.env 를 만들고 값을 채운다.
# (docker compose 는 compose 파일과 같은 디렉터리의 .env 를 자동으로 읽는다)

# Docker Hub (이미지: <DOCKERHUB_ID>/rsi-collector, rsi-api, rsi-frontend)
DOCKERHUB_ID=weseeonggu
TAG=latest

# MySQL root
MYSQL_META_ROOT_PASSWORD=
MYSQL_DATA_ROOT_PASSWORD=

# 애플리케이션(.env.example)과 동일한 값 사용
RSI_DB_USERNAME=dnltjdrn
RSI_DB_PASSWORD=
RSI_REDIS_PASSWORD=

# KRX Open API 인증 키 (collector 컨테이너에서 사용)
KRX_API_KEY=

# 기동 시 캐치업 (첫 배포면 200일 백필, 이후에는 마지막 수집일부터 갭 수집)
RSI_BOOTSTRAP_ENABLED=true

# 호스트 포트 매핑 (해당 포트가 이미 사용 중인 서버에서 변경)
FRONTEND_PORT=80
API_PORT=8081
COLLECTOR_PORT=8080
